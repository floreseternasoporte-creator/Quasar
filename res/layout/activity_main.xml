<?xml version="1.0" encoding="utf-8"?>
<!-- Quasar 2.0 — pantalla principal con navegación inferior: Enviar | Recibir | Historial -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.drex.quasar.StarfieldView
        android:id="@+id/starfield"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/tab_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_bar">

        <!-- Pestaña ENVIAR -->
        <LinearLayout
            android:id="@+id/tab_send"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ImageView
                android:layout_width="220dp"
                android:layout_height="140dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_ob2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Quasar"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tagline"
                android:textSize="14sp"
                android:textColor="@color/gray" />

            <LinearLayout
                android:id="@+id/btn_send"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="44dp"
                android:background="@drawable/btn_primary"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_tab_send" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/send"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="@color/white" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/send_hero"
                android:textSize="14sp"
                android:textColor="@color/gray" />
        </LinearLayout>

        <!-- Pestaña RECIBIR -->
        <LinearLayout
            android:id="@+id/tab_receive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="220dp"
                android:layout_height="140dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_ob4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Quasar"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tagline"
                android:textSize="14sp"
                android:textColor="@color/gray" />

            <LinearLayout
                android:id="@+id/btn_receive"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="44dp"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_tab_receive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/receive"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="@color/white" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/receive_hero"
                android:textSize="14sp"
                android:textColor="@color/gray" />
        </LinearLayout>

        <!-- Pestaña HISTORIAL -->
        <LinearLayout
            android:id="@+id/tab_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/history_sub"
                android:textSize="11sp"
                android:letterSpacing="0.22"
                android:textColor="#22D3EE" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp">

                <ListView
                    android:id="@+id/list_history"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="8dp"
                    android:scrollbars="none"
                    android:clipToPadding="false" />

                <!-- Estado vacío: centrado, con imagen -->
                <LinearLayout
                    android:id="@+id/empty_history_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:src="@drawable/img_history_empty" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/empty_history"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/empty_history_sub"
                        android:textSize="13sp"
                        android:textColor="@color/gray" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Botón de ajustes: flotante arriba a la derecha, estilo SpaceX -->
    <ImageView
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:padding="13dp"
        android:src="@drawable/ic_settings"
        android:alpha="0.9"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/settings_title" />

    <!-- Barra de navegación inferior -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_alignParentBottom="true"
        android:background="#CC0A0D1F"
        android:orientation="horizontal"
        android:weightSum="3"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/nav_send"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_send_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_tab_send" />
            <TextView
                android:id="@+id/nav_send_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_send"
                android:textSize="12sp"
                android:textColor="@color/indigo_light" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_receive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_receive_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_tab_receive"
                android:alpha="0.45" />
            <TextView
                android:id="@+id/nav_receive_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_receive"
                android:textSize="12sp"
                android:textColor="@color/gray" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_history"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/nav_history_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_tab_history"
                android:alpha="0.45" />
            <TextView
                android:id="@+id/nav_history_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_history"
                android:textSize="12sp"
                android:textColor="@color/gray" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
